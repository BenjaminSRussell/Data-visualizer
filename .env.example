DATABASE_URL=postgresql://user:password@localhost:5432/data_visualizer
HOST=127.0.0.1
PORT=8000
# Optional Redis cache (#26) — app works if unset/down
REDIS_URL=
REDIS_TTL_SECONDS=30
# Optional auth (#27) — default local bypass
AUTH_DISABLED=false
UI_AUTH_TOKEN=change-me  # required when AUTH_DISABLED=false
# Freshness webhook (#31)
FRESHNESS_WEBHOOK=
